# Rule for ESP32 USB serial devices
# This file should be placed in /etc/udev/rules.d/
# After creating this file, run: sudo udevadm control --reload-rules

# Give dialout group access to USB serial devices
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", GROUP="dialout", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", GROUP="dialout", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", GROUP="dialout", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", GROUP="dialout", MODE="0666"

# Generic rule for all USB-to-serial converters
KERNEL=="ttyUSB[0-9]*", GROUP="dialout", MODE="0666"
KERNEL=="ttyACM[0-9]*", GROUP="dialout", MODE="0666"
